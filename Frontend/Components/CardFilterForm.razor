@inject HttpClient Http

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center" style="cursor: pointer;" @onclick="ToggleExpand">
        <h5 class="mb-0">Filtr FPGA</h5>
        <span>@(isExpanded ? "-" : "+")</span>
    </div>
    
    @if (isExpanded)
    {
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Rodzina</label>
                <input type="text" class="form-control" @bind="Filter.Family">
            </div>

            <div class="mb-3">
                <label class="form-label">Zastosowanie</label>
                <input type="text" class="form-control" @bind="Filter.Purpose">
            </div>

            <div class="mb-3">
                <label class="form-label">Minimalna przepustowość (Gbps)</label>
                <input type="number" min="0" class="form-control" @bind:event="oninput" @bind="Filter.MinThroughputGbps" @onchange="ValidateRange">
            </div>

            <div class="mb-3">
                <label class="form-label">Maksymalna przepustowość (Gbps)</label>
                <input type="number" min="0" class="form-control" @bind:event="oninput" @bind="Filter.MaxThroughputGbps" @onchange="ValidateRange">
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-primary" @onclick="OnSearchClick" disabled="@isLoading">Szukaj</button>
                <button class="btn btn-secondary" @onclick="OnResetClick">Wyczyść</button>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = false;
    private bool isExpanded = true;

    [Parameter]
    public FpgaCardFilter Filter { get; set; } = new();
    [Parameter]
    public EventCallback<List<FpgaCardSummary>> OnSearch { get; set; }
    [Parameter]
    public EventCallback OnReset { get; set; }

    private void ToggleExpand()
    {
        isExpanded = !isExpanded;
    }

    private void ValidateRange()
    {
        if (Filter.MinThroughputGbps.HasValue && Filter.MaxThroughputGbps.HasValue)
        {
            if (Filter.MaxThroughputGbps < Filter.MinThroughputGbps)
                Filter.MaxThroughputGbps = Filter.MinThroughputGbps;
            
            if (Filter.MinThroughputGbps > Filter.MaxThroughputGbps)
                Filter.MinThroughputGbps = Filter.MaxThroughputGbps;
        }
    }

    private async Task OnSearchClick()
    {
        isLoading = true;
        try
        {
            var query = new Dictionary<string, string>();
            
            if (!string.IsNullOrEmpty(Filter.Family))
                query["family"] = Filter.Family;
            if (!string.IsNullOrEmpty(Filter.Purpose))
                query["purpose"] = Filter.Purpose;
            if (Filter.MinThroughputGbps.HasValue)
                query["minThroughputGbps"] = Filter.MinThroughputGbps.ToString();
            if (Filter.MaxThroughputGbps.HasValue)
                query["maxThroughputGbps"] = Filter.MaxThroughputGbps.ToString();

            var queryString = string.Join("&", query.Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value)}"));
            var url = string.IsNullOrEmpty(queryString) ? "api/FpgaCard/filter" : $"api/FpgaCard/filter?{queryString}";
            
            var results = await Http.GetFromJsonAsync<List<FpgaCardSummary>>(url);
            await OnSearch.InvokeAsync(results);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnResetClick()
    {
        Filter = new();
        await OnReset.InvokeAsync();
    }
}
